{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build OpenGL Project",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++17",
                "${workspaceFolder}/main.cpp",
                "${workspaceFolder}/src/glad.c",
                "${workspaceFolder}/ResourceManager.cpp",
                "${workspaceFolder}/SpriteRenderer.cpp",
                "${workspaceFolder}/Game.cpp",
                "-I${workspaceFolder}/include",
                "-I${workspaceFolder}",
                "-I${workspaceFolder}/glm",
                "-I${workspaceFolder}/glad",
                "-I${workspaceFolder}/KHR",
                "-lglfw",
                "-lGL",
                "-ldl",
                "-lpthread",
                "-o",
                "${workspaceFolder}/breakout"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}